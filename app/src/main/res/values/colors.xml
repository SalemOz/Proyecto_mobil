<?xml version="1.0" encoding="utf-8"?>
<!--
  Paleta única y semántica de Oído+.

  Regla: los layouts y drawables nunca escriben hex a mano ni usan nombres de color
  "de pantalla" (settings_*, home_*). Se elige el token por su significado:
  marca, superficie, texto, borde o estado.
-->
<resources>

    <!-- ============================ Marca ============================ -->
    <!-- Azul de marca: antes convivían primary_blue (#1565C0) y brand_blue (#2F5FDE). -->
    <color name="brand_primary">#FF2F5FDE</color>
    <color name="brand_primary_dark">#FF1E45B0</color>
    <color name="brand_primary_container">#FFE3F0FC</color>
    <!-- Verde azulado de apoyo. -->
    <color name="brand_accent">#FF1D9E75</color>

    <!-- ========================= Superficies ========================= -->
    <color name="surface">#FFFFFFFF</color>
    <!-- Fondo de pantalla, compartido por Inicio, Historial y Ajustes. -->
    <color name="surface_screen">#FFE8F1FA</color>
    <color name="surface_card">#FFFFFFFF</color>
    <color name="surface_card_selected">#FFE3F0FC</color>

    <!-- ============================ Texto ============================ -->
    <color name="text_primary">#FF1A2B4A</color>
    <color name="text_secondary">#FF6B7B99</color>
    <color name="text_muted">#FF8A94A6</color>
    <color name="text_hint">#FFB0BEC5</color>
    <color name="text_on_brand">#FFFFFFFF</color>

    <!-- =========================== Bordes ============================ -->
    <color name="outline">#FFD6E4F0</color>
    <color name="outline_variant">#FFE3E8F0</color>
    <color name="ripple">#1F2F5FDE</color>
    <!-- Ripple sobre un fondo de marca (botón principal del onboarding). -->
    <color name="ripple_on_brand">#33FFFFFF</color>

    <!-- ========================== Estados ============================ -->
    <color name="success">#FF4CAF50</color>
    <color name="danger">#FFE94B5F</color>
    <color name="slider_track">#FFE0E0E0</color>

    <!-- ======================== Navegación =========================== -->
    <color name="nav_active">#FF2F5FDE</color>
    <color name="nav_inactive">#FF6B7B99</color>

    <!-- ================= Decoración de bienvenida ==================== -->
    <color name="bubble_blue_strong">#FFD6E8F7</color>
    <color name="bubble_blue_soft">#FFE3F0FC</color>
    <color name="bubble_blue_deep">#FFDDE9F6</color>
    <color name="halo_illustration">#FFE8F4FD</color>
    <color name="dots_pattern">#FFC8DCF0</color>

</resources>
