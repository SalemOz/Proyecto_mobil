<?xml version="1.0" encoding="utf-8"?>
<!--
  Color de un control seleccionable (botón de ambiente, tarjeta de oído).
  El estado "selected" lo pone el contenedor y los hijos lo heredan.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_primary" android:state_selected="true" />
    <item android:color="@color/text_secondary" />
</selector>
