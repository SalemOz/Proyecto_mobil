<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_blue"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Step indicator: 1/2 -->
        <TextView
            android:id="@+id/tv_step_indicador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_step_indicator"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="1 / 2"
            android:textColor="@color/primary_blue"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Dots decoration (top right area) -->
        <ImageView
            android:id="@+id/iv_patron_puntos"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="16dp"
            android:alpha="0.5"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dots_pattern"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_step_indicador" />

        <!-- Profile avatar container -->
        <FrameLayout
            android:id="@+id/fl_perfil"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="64dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Circle background -->
            <ImageView
                android:id="@+id/iv_fondo_avatar"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_profile_circle" />

            <!-- Person icon -->
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_profile_person" />

            <!-- Edit pencil badge -->
            <FrameLayout
                android:id="@+id/fl_editar_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end">

                <ImageView
                    android:id="@+id/iv_fondo_editar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/bg_edit_circle" />

                <ImageView
                    android:id="@+id/iv_editar_avatar"
                    android:layout_width="16dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/ic_menu_edit" />
            </FrameLayout>
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:text="Cuéntanos sobre ti"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fl_perfil" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_subtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Para personalizar tu experiencia,\nnecesitamos conocerte un poco."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_titulo" />

        <!-- Section: Name -->
        <LinearLayout
            android:id="@+id/ll_seccion_nombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitulo">

            <!-- Label -->
            <LinearLayout
                android:id="@+id/ll_label_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_icono_nombre"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/tv_pregunta_nombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="¿Cómo te llamas?"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Input field -->
            <FrameLayout
                android:id="@+id/ll_poner_nombre"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_name_input">

                <ImageView
                    android:id="@+id/iv_icono_nombre1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/et_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="16dp"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="Escribe tu nombre..."
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Section: Affected ear -->
        <LinearLayout
            android:id="@+id/ll_seccion_oido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_seccion_nombre">

            <!-- Label -->
            <LinearLayout
                android:id="@+id/ll_pregunta_oido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_icono_oido"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ear_sound" />

                <TextView
                    android:id="@+id/tv_pregunta_oido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="¿Qué oído está afectado?"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Ear selection cards -->
            <LinearLayout
                android:id="@+id/ll_opciones_oido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Left ear card (unselected) -->
                <FrameLayout
                    android:id="@+id/fl_oido_izquierdo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ear_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/ll_contenido_izquierdo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_oido_izquierdo"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:adjustViewBounds="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ear_left" />

                        <TextView
                            android:id="@+id/tv_oido_izquierdo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Izquierdo"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_check_izquierdo"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Right ear card (selected) -->
                <FrameLayout
                    android:id="@+id/fl_oido_derecho"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ear_card_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/ll_contenido_derecho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_oido_derecho"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ear_right" />

                        <TextView
                            android:id="@+id/tv_oido_derecho"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Derecho"
                            android:textColor="@color/primary_blue"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_check_derecho"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check" />

                    <!-- Checkmark badge -->

                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Privacy notice -->
        <LinearLayout
            android:id="@+id/ll_aviso_privacidad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_seccion_oido">

            <ImageView
                android:id="@+id/iv_candado_privacidad"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock" />

            <TextView
                android:id="@+id/tv_aviso_privacidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Solo solicitamos la información necesaria\npara configurar tu experiencia."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Continue button -->
        <Button
            android:id="@+id/btn_continuar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_onboarding_button"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"
            android:text="CONTINUAR"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_aviso_privacidad" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
