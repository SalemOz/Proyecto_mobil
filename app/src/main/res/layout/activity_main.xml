<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/space_3xl">

        <ImageView
            android:id="@+id/iv_dots_pattern"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="@dimen/space_lg"
            android:alpha="0.5"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dots_pattern"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Avatar + botón para cambiarlo -->
        <FrameLayout
            android:id="@+id/fl_profile"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="64dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_profile_bg"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_profile_circle" />

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_profile_person" />

            <FrameLayout
                android:id="@+id/fl_edit_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/iv_edit_avatar_bg"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/bg_edit_circle" />

                <ImageView
                    android:id="@+id/iv_edit_avatar"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_edit_pencil" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_onboarding_title"
            style="@style/Text.Oido.OnboardingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3xl"
            android:layout_marginTop="@dimen/space_2xl"
            android:layout_marginEnd="@dimen/space_3xl"
            android:text="@string/onboarding_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fl_profile" />

        <TextView
            android:id="@+id/tv_onboarding_subtitle"
            style="@style/Text.Oido.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/onboarding_subtitle"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_onboarding_title" />

        <!-- Sección: nombre -->
        <LinearLayout
            android:id="@+id/ll_name_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2xl"
            android:layout_marginTop="@dimen/space_3xl"
            android:layout_marginEnd="@dimen/space_2xl"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_onboarding_subtitle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/tv_name_question"
                    style="@style/Text.Oido.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_name_question" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_control_outline">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/space_lg"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person"
                    app:tint="@color/text_muted" />

                <EditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:background="@null"
                    android:hint="@string/onboarding_name_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Sección: oído afectado -->
        <LinearLayout
            android:id="@+id/ll_ear_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2xl"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="@dimen/space_2xl"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_name_section">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ear_sound" />

                <TextView
                    android:id="@+id/tv_ear_question"
                    style="@style/Text.Oido.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_ear_question" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Oído izquierdo -->
                <FrameLayout
                    android:id="@+id/fl_ear_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_selectable_control"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_ear_left"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ear_left" />

                        <TextView
                            android:id="@+id/tv_ear_left"
                            style="@style/Text.Oido.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_ear_left"
                            android:textColor="@color/selectable_control_color" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rb_ear_left"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_gravity="top|end"
                        android:buttonTint="@color/selectable_control_color"
                        android:checked="false"
                        android:contentDescription="@string/onboarding_ear_left_description"
                        android:duplicateParentState="true" />
                </FrameLayout>

                <!-- Oído derecho (seleccionado por defecto) -->
                <FrameLayout
                    android:id="@+id/fl_ear_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_selectable_control"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_ear_right"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@null"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ear_right" />

                        <TextView
                            android:id="@+id/tv_ear_right"
                            style="@style/Text.Oido.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/onboarding_ear_right"
                            android:textColor="@color/selectable_control_color" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rb_ear_right"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_gravity="top|end"
                        android:buttonTint="@color/selectable_control_color"
                        android:checked="true"
                        android:contentDescription="@string/onboarding_ear_right_description"
                        android:duplicateParentState="true" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Aviso de privacidad -->
        <LinearLayout
            android:id="@+id/ll_privacy_notice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="@dimen/space_2xl"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_ear_section">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="6dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_privacy_notice"
                style="@style/Text.Oido.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/onboarding_privacy_notice" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_continue"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/space_2xl"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="@dimen/space_2xl"
            android:background="@drawable/bg_onboarding_button"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawablePadding="@dimen/space_sm"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"
            android:text="@string/onboarding_continue"
            android:textAllCaps="true"
            android:textColor="@color/text_on_brand"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_privacy_notice" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
