<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/space_3xl">

            <include layout="@layout/view_top_bar" />

            <TextView
                android:id="@+id/tv_screen_title"
                style="@style/Text.Oido.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/settings_title" />

            <!-- Tarjeta: perfil -->
            <LinearLayout
                android:id="@+id/ll_profile_card"
                style="@style/Widget.Oido.Card"
                android:layout_marginTop="@dimen/space_lg"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:importantForAccessibility="no">

                    <TextView
                        android:id="@+id/tv_avatar_letter"
                        style="@style/Text.Oido.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/text_on_brand"
                        tools:text="D" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_profile_name"
                        style="@style/Text.Oido.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Delia" />

                    <TextView
                        android:id="@+id/tv_profile_ear"
                        style="@style/Text.Oido.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="Oído afectado: derecho" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sección: preferencias -->
            <TextView
                style="@style/Text.Oido.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/settings_preferences" />

            <LinearLayout
                android:id="@+id/ll_preferences_card"
                style="@style/Widget.Oido.Card"
                android:layout_marginTop="@dimen/space_sm"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <LinearLayout
                    style="@style/Widget.Oido.SettingsRow"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg">

                    <ImageView
                        style="@style/Widget.Oido.SettingsIcon"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_notifications" />

                    <TextView
                        style="@style/Widget.Oido.SettingsRowTitle"
                        android:text="@string/settings_notifications" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_notifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:checked="true"
                        android:contentDescription="@string/settings_notifications" />
                </LinearLayout>

                <View style="@style/Widget.Oido.Divider" />

                <LinearLayout
                    android:id="@+id/row_default_ambient"
                    style="@style/Widget.Oido.SettingsRow.Action"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg">

                    <ImageView
                        style="@style/Widget.Oido.SettingsIcon"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_leaf" />

                    <TextView
                        style="@style/Widget.Oido.SettingsRowTitle"
                        android:text="@string/settings_default_ambient" />

                    <TextView
                        android:id="@+id/tv_default_ambient_value"
                        style="@style/Widget.Oido.SettingsRowValue"
                        android:text="@string/home_ambient_low" />

                    <ImageView
                        style="@style/Widget.Oido.SettingsChevron"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View style="@style/Widget.Oido.Divider" />

                <LinearLayout
                    android:id="@+id/row_language"
                    style="@style/Widget.Oido.SettingsRow.Action"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg">

                    <ImageView
                        style="@style/Widget.Oido.SettingsIcon"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_language" />

                    <TextView
                        style="@style/Widget.Oido.SettingsRowTitle"
                        android:text="@string/settings_language" />

                    <TextView
                        android:id="@+id/tv_language_value"
                        style="@style/Widget.Oido.SettingsRowValue"
                        android:text="@string/settings_spanish" />

                    <ImageView
                        style="@style/Widget.Oido.SettingsChevron"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sección: soporte -->
            <TextView
                style="@style/Text.Oido.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/settings_support" />

            <LinearLayout
                android:id="@+id/ll_support_card"
                style="@style/Widget.Oido.Card"
                android:layout_marginTop="@dimen/space_sm"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <LinearLayout
                    android:id="@+id/row_help"
                    style="@style/Widget.Oido.SettingsRow.Action"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg">

                    <ImageView
                        style="@style/Widget.Oido.SettingsIcon"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_help_circle" />

                    <TextView
                        style="@style/Widget.Oido.SettingsRowTitle"
                        android:text="@string/settings_help" />

                    <ImageView
                        style="@style/Widget.Oido.SettingsChevron"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View style="@style/Widget.Oido.Divider" />

                <LinearLayout
                    android:id="@+id/row_about"
                    style="@style/Widget.Oido.SettingsRow.Action"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg">

                    <ImageView
                        style="@style/Widget.Oido.SettingsIcon"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info_circle" />

                    <TextView
                        style="@style/Widget.Oido.SettingsRowTitle"
                        android:text="@string/settings_about" />

                    <ImageView
                        style="@style/Widget.Oido.SettingsChevron"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cerrar sesión -->
            <LinearLayout
                android:id="@+id/row_logout"
                style="@style/Widget.Oido.SettingsRow.Action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:background="@drawable/bg_card"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg">

                <ImageView
                    style="@style/Widget.Oido.SettingsIcon"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/danger" />

                <TextView
                    style="@style/Widget.Oido.SettingsRowTitle"
                    android:text="@string/settings_logout"
                    android:textColor="@color/danger" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_nav_container"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
