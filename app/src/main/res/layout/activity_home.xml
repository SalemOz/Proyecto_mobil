<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/space_2xl">

            <include layout="@layout/view_top_bar" />

            <!-- Saludo + ilustración del oído -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:id="@+id/ll_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/iv_ear_illustration"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_greeting"
                        style="@style/Text.Oido.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="¡Hola, Delia! 👋" />

                    <TextView
                        android:id="@+id/tv_config_label"
                        style="@style/Text.Oido.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/home_config_label" />

                    <!-- Oído configurado -->
                    <LinearLayout
                        android:id="@+id/ll_ear_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="6dp"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ear_small"
                            app:tint="@color/brand_primary" />

                        <TextView
                            android:id="@+id/tv_ear_type"
                            style="@style/Text.Oido.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/brand_primary"
                            tools:text="Oído derecho" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_ear_illustration"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ear_right" />
            </RelativeLayout>

            <!-- Tarjeta: amplificación y estado de la conexión -->
            <LinearLayout
                android:id="@+id/ll_amplification_card"
                style="@style/Widget.Oido.Card"
                android:layout_marginTop="@dimen/space_2xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_amplification_title"
                            style="@style/Text.Oido.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_amplification_title" />

                        <TextView
                            android:id="@+id/tv_amplification_desc"
                            style="@style/Text.Oido.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/home_amplification_desc" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_amplification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:checked="true"
                        android:contentDescription="@string/home_amplification_title" />
                </LinearLayout>

                <View
                    style="@style/Widget.Oido.Divider"
                    android:layout_marginTop="@dimen/space_lg"
                    android:layout_marginBottom="@dimen/space_lg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_connection_title"
                            style="@style/Text.Oido.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_connection_title" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/view_status_dot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_status_dot" />

                            <TextView
                                android:id="@+id/tv_mic_status"
                                style="@style/Text.Oido.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                android:text="@string/home_mic_active"
                                android:textColor="@color/success" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_microphone"
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:background="@drawable/bg_chip"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/space_md"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/brand_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta: volumen de salida -->
            <LinearLayout
                android:id="@+id/ll_volume_section"
                style="@style/Widget.Oido.Card"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_volume"
                        app:tint="@color/brand_primary" />

                    <TextView
                        android:id="@+id/tv_volume_title"
                        style="@style/Text.Oido.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="@string/home_volume_title" />

                    <TextView
                        android:id="@+id/tv_volume_percent"
                        style="@style/Text.Oido.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_xs"
                        android:textColor="@color/brand_primary"
                        tools:text="70%" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:contentDescription="@string/home_volume_title"
                    android:value="70"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:haloColor="@color/brand_primary_container"
                    app:thumbColor="@color/brand_primary"
                    app:thumbElevation="4dp"
                    app:thumbRadius="10dp"
                    app:tickVisible="false"
                    app:trackColorActive="@color/brand_primary"
                    app:trackColorInactive="@color/slider_track"
                    app:trackHeight="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Oido.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_volume_min" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/Text.Oido.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_volume_max" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta: modo de ambiente -->
            <LinearLayout
                android:id="@+id/ll_ambient_section"
                style="@style/Widget.Oido.Card"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_leaf"
                        app:tint="@color/brand_accent" />

                    <TextView
                        android:id="@+id/tv_ambient_title"
                        style="@style/Text.Oido.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="@string/home_ambient_title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_ambient_desc"
                    style="@style/Text.Oido.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/home_ambient_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="horizontal">

                    <!-- Bajo (seleccionado por defecto) -->
                    <LinearLayout
                        android:id="@+id/btn_ambient_low"
                        style="@style/Widget.Oido.AmbientButton"
                        android:layout_marginEnd="@dimen/space_sm">

                        <ImageView
                            style="@style/Widget.Oido.AmbientIcon"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_leaf" />

                        <TextView
                            style="@style/Widget.Oido.AmbientLabel"
                            android:text="@string/home_ambient_low" />
                    </LinearLayout>

                    <!-- Medio -->
                    <LinearLayout
                        android:id="@+id/btn_ambient_mid"
                        style="@style/Widget.Oido.AmbientButton"
                        android:layout_marginEnd="@dimen/space_sm">

                        <ImageView
                            style="@style/Widget.Oido.AmbientIcon"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_wave_medium" />

                        <TextView
                            style="@style/Widget.Oido.AmbientLabel"
                            android:text="@string/home_ambient_mid" />
                    </LinearLayout>

                    <!-- Alto -->
                    <LinearLayout
                        android:id="@+id/btn_ambient_high"
                        style="@style/Widget.Oido.AmbientButton">

                        <ImageView
                            style="@style/Widget.Oido.AmbientIcon"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_wave_high" />

                        <TextView
                            style="@style/Widget.Oido.AmbientLabel"
                            android:text="@string/home_ambient_high" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_nav_container"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
