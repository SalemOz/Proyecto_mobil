<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Large bubble top-right -->
    <item
        android:right="-50dp"
        android:top="-30dp">
        <shape android:shape="oval">
            <solid android:color="#D6E8F7" />
            <size
                android:width="160dp"
                android:height="160dp" />
        </shape>
    </item>
    <!-- Medium bubble center-top -->
    <item
        android:left="20dp"
        android:top="-20dp">
        <shape android:shape="oval">
            <solid android:color="#E3F0FC" />
            <size
                android:width="120dp"
                android:height="120dp" />
        </shape>
    </item>
    <!-- Small bubble top-left -->
    <item
        android:left="-30dp"
        android:top="40dp">
        <shape android:shape="oval">
            <solid android:color="#DDE9F6" />
            <size
                android:width="80dp"
                android:height="80dp" />
        </shape>
    </item>
</layer-list>
