# Estilo de código de Oído+. Aplica a todo el proyecto.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.xml]
indent_size = 4

[*.{md,toml,properties}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
